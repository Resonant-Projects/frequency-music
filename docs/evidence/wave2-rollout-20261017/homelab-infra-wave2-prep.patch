diff --git a/kubernetes/infra/frequency-worker/deployment.yaml b/kubernetes/infra/frequency-worker/deployment.yaml
index 2b6def28..43f5b852 100644
--- a/kubernetes/infra/frequency-worker/deployment.yaml
+++ b/kubernetes/infra/frequency-worker/deployment.yaml
@@ -16,7 +16,7 @@ spec:
       labels:
         app: frequency-worker
       annotations:
-        rproj.source-revision: 81150337a777594c3a39f2be0a5f75b5e226d9d3
+        rproj.source-revision: 6f332386d01089270b740ea009ee5088d8534a91
     spec:
       automountServiceAccountToken: false
       enableServiceLinks: false
@@ -30,11 +30,39 @@ spec:
         seccompProfile:
           type: RuntimeDefault
       terminationGracePeriodSeconds: 86400
+      # The audit outbox (AGENT_OUTBOX_DIR) is its own durable root: the worker
+      # refuses to spool unless the directory already exists. Create it on the
+      # retained volume before the worker starts; idempotent on every start.
+      initContainers:
+      - name: outbox-dir
+        image: registry.rproj.art/frequency-music/frequency-music-agent@sha256:6853836008280dbca712558e412a946b73a79993ad5250b54e67c079f4d37c5d
+        command:
+        - /bin/sh
+        - -c
+        - mkdir -p /data/outbox && chmod 700 /data/outbox && sync
+        resources:
+          requests:
+            cpu: 10m
+            memory: 16Mi
+          limits:
+            cpu: 100m
+            memory: 64Mi
+        securityContext:
+          allowPrivilegeEscalation: false
+          readOnlyRootFilesystem: true
+          capabilities:
+            drop:
+            - ALL
+        volumeMounts:
+        - name: state
+          mountPath: /data
       containers:
       - name: worker
-        image: registry.rproj.art/frequency-music/frequency-music-agent@sha256:06bcf3d679af8945897a188daa9dd75bf54fa6b8768bdbb1e4d32bd88fdbfddb
+        image: registry.rproj.art/frequency-music/frequency-music-agent@sha256:6853836008280dbca712558e412a946b73a79993ad5250b54e67c079f4d37c5d
         workingDir: /app/agent
         env:
+        - name: AGENT_OUTBOX_DIR
+          value: /data/outbox
         - name: CODEX_ENABLED
           value: 'false'
         - name: CODEX_SPECIALIST
@@ -126,7 +154,7 @@ spec:
       # YouTube PO-token provider for transcript capture (bgutil server built
       # into the same image), reachable only inside the pod on 127.0.0.1:4416.
       - name: pot-provider
-        image: registry.rproj.art/frequency-music/frequency-music-agent@sha256:06bcf3d679af8945897a188daa9dd75bf54fa6b8768bdbb1e4d32bd88fdbfddb
+        image: registry.rproj.art/frequency-music/frequency-music-agent@sha256:6853836008280dbca712558e412a946b73a79993ad5250b54e67c079f4d37c5d
         workingDir: /opt/bgutil-server
         # Node as PID 1 ignores SIGTERM, which held a terminating pod (and the
         # worker's ReadWriteOncePod volume) for the full grace period. The
