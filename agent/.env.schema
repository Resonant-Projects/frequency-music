# Frequency Music — LangGraph agent server environment schema (varlock + 1Password)
#
# Activation note: the agent/ workspace currently uses npm. To use varlock here,
# add `varlock` + `@varlock/1password-plugin` to agent/package.json and load via
# `import "varlock/auto-load"` or `varlock run --` (see migration notes). Until
# then this file documents the contract and feeds the vault inventory.
#
# @defaultSensitive=true @defaultRequired=infer
# @currentEnv=$APP_ENV
# @generateTypes(lang=ts, path=./env.d.ts)
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=forEnv(dev))
# ---

# @public @type=enum(dev, ci, prod)
APP_ENV=dev

# @optional @type=opServiceAccountToken
OP_SERVICE_ACCOUNT_TOKEN=

# ─── Config ─────────────────────────────────────────────────────────────────

# @public @type=url
CONVEX_SITE_URL=http://convex-backend.paas.rproj.art
# @public @optional @type=url
CONVEX_URL=ref(CONVEX_SITE_URL)
# @public @optional
WEEKLY_BRIEF_AGENT_MODEL=anthropic/claude-sonnet-4.6
# @public @optional @type=url
CODEX_APP_SERVER_URL=
# @public @optional
CODEX_APP_SERVER_MODEL=codex-local
# @public @optional @type=boolean
LANGSMITH_TRACING=true
# @public @optional
LANGSMITH_PROJECT=frequency-music-agents
# @public @optional @type=url
PROXMOX_API_URL=https://prox.rproj.art:8006/api2/json
# @public @optional @type=boolean
PROXMOX_ALLOW_SELF_SIGNED=true

# ─── Secrets (resolved from 1Password vault: Country Manor Lab) ───────────────

# @sensitive @required
AGENT_TOOL_SECRET=op(op://Country Manor Lab/agent-tool-secret/credential)
# @sensitive @optional
ANTHROPIC_API_KEY=op(op://Country Manor Lab/anthropic-api-key/credential)
# @sensitive @optional
OPENROUTER_API_KEY=op(op://Country Manor Lab/openrouter-api-key/credential)
# @sensitive @optional
LANGSMITH_API_KEY=op(op://Country Manor Lab/langsmith-api-key/credential)
# @sensitive @optional
CODEX_APP_SERVER_AUTH_TOKEN=op(op://Country Manor Lab/codex-app-server-token/credential)
# @sensitive @optional
PROXMOX_TOKEN_ID=op(op://Country Manor Lab/proxmox-api-token/token-id)
# @sensitive @optional
PROXMOX_TOKEN_SECRET=op(op://Country Manor Lab/proxmox-api-token/token-secret)
