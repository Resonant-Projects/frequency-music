# Frequency Music — LangGraph agent server environment schema (varlock + 1Password)
#
# @defaultSensitive=true @defaultRequired=infer
# @currentEnv=$APP_ENV
# @generateTypes(lang=ts, path=./env.d.ts)
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=forEnv(dev))
# ---

# @public @type=enum(dev, ci, prod, test)
APP_ENV=dev

# @optional @type=opServiceAccountToken
OP_SERVICE_ACCOUNT_TOKEN=

# ─── Config ─────────────────────────────────────────────────────────────────

# HTTP actions, including /agent-tools/*, use the site origin.
# @public @type=url
CONVEX_SITE_URL=https://convex-http.resonantprojects.art
# Convex queries and mutations use the backend API origin.
# @public @optional @type=url
CONVEX_URL=https://convex.resonantprojects.art
# @public @optional
WEEKLY_BRIEF_AGENT_MODEL=anthropic/claude-sonnet-5.5
# @public @optional @type=url
CODEX_APP_SERVER_URL=
# @public @optional
CODEX_APP_SERVER_MODEL=codex-local
# @public @optional @type=boolean
LANGSMITH_TRACING=true
# @public @optional
LANGSMITH_PROJECT=frequency-music-agents
# @public @optional @type=url
PROXMOX_API_URL=https://prox.rproj.art:8006/api2/json
# @public @optional @type=boolean
PROXMOX_ALLOW_SELF_SIGNED=true

# ─── Secrets (1Password vaults named in each reference) ──────────────────────

# @sensitive @required
AGENT_TOOL_SECRET=op("op://Country Manor Lab/agent-tool-secret/credential")
# @sensitive @required
ANTHROPIC_API_KEY=op("op://Homelab Runtime/s454tugq5n2dxfhmzjhsp3drne/credential")
# @sensitive @optional
OPENROUTER_API_KEY=op("op://Country Manor Lab/OpenRouter API Key - Frequency Music/credential")
# @sensitive @optional
FIRECRAWL_API_KEY=op("op://Country Manor Lab/Firecrawl API Key/credential", allowMissing=true)
# Self-hosted Firecrawl base URL (the Lab's is http://172.16.10.38:3002 from the
# cluster). When set, search goes there and the Cloud key is never sent.
# @public @optional @type=url
FIRECRAWL_API_URL=
# Free keyless Firecrawl Cloud Research Index discovery, separate from Lab Firecrawl.
# No general Alexandria provider execution, paid calls, or passage capture.
# @public @optional @type=boolean
ALEXANDRIA_RESEARCH_ENABLED=false
# @sensitive @optional
CRAWL4AI_API_TOKEN=op("op://Homelab Runtime/wxk7pv6ka6bkx2wwr6amsgkyre/password", allowMissing=true)
# @public @optional @type=url
CRAWL4AI_URL=https://crawl4ai.rproj.art
# @public @optional @type=boolean
# Enable only after verifying server-side egress blocks private/reserved IPs after DNS and on redirects
# (verified for Crawl4AI 0.9.4 on 2026-09-29; see docs/source-scout-research.md).
CRAWL4AI_EGRESS_GUARDED=false
# @public @optional @type=boolean
# Lets Source Scout scrape PDFs and pages Crawl4AI could not capture through the self-hosted
# Firecrawl at FIRECRAWL_API_URL (never Firecrawl Cloud). Enable only after verifying its egress
# proxy blocks private/reserved targets (verified for the Lab Firecrawl on 2026-09-30).
FIRECRAWL_SCRAPE_EGRESS_GUARDED=false
# Groq key for transcript capture: YouTube Sources' audio (yt-dlp) is transcribed with Groq
# Whisper. Without it, transcript-capture runs skip and say so.
# @sensitive @optional
GROQ_API_KEY=op("op://Homelab Runtime/z2gmgubqg44r2qlmwztr4d4rfe/credential", allowMissing=true)
# @public @optional
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# yt-dlp binary and plugin folder (set by the agent image) and the bgutil PO-token provider
# (the worker pod's sidecar, http://127.0.0.1:4416).
# @public @optional
YTDLP_PATH=
# @public @optional
YTDLP_PLUGIN_DIRS=
# ffmpeg binary for splitting audio over Groq's upload limit (default: ffmpeg on PATH)
# @public @optional
FFMPEG_PATH=
# @public @optional @type=url
BGUTIL_POT_BASE_URL=
# Free OpenAlex key for Source Scout search and abstract lookups. Without it, calls share
# OpenAlex's small keyless daily budget per egress IP and fail with 429 once it is spent.
# @sensitive @optional
OPENALEX_API_KEY=op("op://Homelab Runtime/OpenAlex API Key/credential", allowMissing=true)
# @sensitive @optional
LANGSMITH_API_KEY=op("op://Homelab Runtime/langsmith-api-key/credential")
# @sensitive @optional
CODEX_APP_SERVER_AUTH_TOKEN=op("op://Country Manor Lab/codex-app-server-token/credential")
# @sensitive @optional
PROXMOX_TOKEN_ID=op("op://Country Manor Lab/proxmox-api-token/token-id")
# @sensitive @optional
PROXMOX_TOKEN_SECRET=op("op://Country Manor Lab/proxmox-api-token/token-secret")

# MCP process only; supplied independently of AGENT_TOOL_SECRET.
# @sensitive @optional
MCP_SHARED_SECRET=
# @public @optional @type=number
MCP_PORT=2025
