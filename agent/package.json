    "test": "vp test",
    "mcp": "vpx tsx src/mcp/main.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.12",
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.1",
    "@langchain/langgraph-sdk": "1.12.7",
    "@openai/codex-sdk": "0.162.1",
    "convex": "1.46.0",
    "convex-helpers": "0.1.128",
    "deepagents": "1.14.2",
    "esbuild": "0.28.2",
    "hono": "4.13.13",
    "langchain": "1.5.16",
    "langsmith": "0.11.0",
    "tsx": "4.23.15",
    "zod": "4.6.7",
    "@modelcontextprotocol/sdk": "1.32.1",
    "varlock": "1.22.0",
    "@varlock/1password-plugin": "2.0.5"
