{
  "name": "resonant-projects-agent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "langgraphjs dev",
    "build": "langgraphjs build -t resonant-projects-agent:local",
    "up": "langgraphjs up",
    "verify": "bunx tsc --noEmit",
    "smoke:proxmox": "bun scripts/spike-proxmox.ts",
    "smoke:research-pipeline": "bun scripts/smoke-research-pipeline.ts",
    "run:research-pipeline": "RUN_RESEARCH_PIPELINE_REAL=true bun scripts/smoke-research-pipeline.ts",
    "worker": "bun src/worker/runner.ts",
    "automation:local": "bun scripts/build-and-smoke.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@langchain/anthropic": "1.3.29",
    "@langchain/core": "1.1.46",
    "@langchain/langgraph": "1.3.0",
    "@langchain/langgraph-sdk": "1.9.2",
    "@openai/codex-sdk": "^0.142.5",
    "convex": "1.34.1",
    "convex-helpers": "0.1.114",
    "deepagents": "1.10.2",
    "langchain": "1.4.0",
    "langsmith": "0.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "1.2.1",
    "typescript": "^5.9.3"
  }
}
