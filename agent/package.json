{
  "name": "resonant-projects-agent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "langgraphjs dev",
    "build": "langgraphjs build -t resonant-projects-agent:local",
    "up": "langgraphjs up",
    "verify": "vpx tsc --noEmit",
    "smoke:proxmox": "vpx tsx scripts/spike-proxmox.ts",
    "smoke:research-pipeline": "vpx tsx scripts/smoke-research-pipeline.ts",
    "run:research-pipeline": "RUN_RESEARCH_PIPELINE_REAL=true vpx tsx scripts/smoke-research-pipeline.ts",
    "worker": "vpx tsx src/worker/runner.ts",
    "automation:local": "vpx tsx scripts/build-and-smoke.ts",
    "test": "vp test"
  },
  "dependencies": {
    "@langchain/anthropic": "1.3.29",
    "@langchain/core": "1.2.4",
    "@langchain/langgraph": "1.4.8",
    "@langchain/langgraph-sdk": "1.9.28",
    "@openai/codex-sdk": "0.146.0",
    "convex": "1.34.1",
    "convex-helpers": "0.1.120",
    "deepagents": "1.12.1",
    "esbuild": "0.28.1",
    "hono": "4.12.33",
    "langchain": "1.5.4",
    "langsmith": "0.8.9",
    "tsx": "4.23.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "1.4.3",
    "postcss": "8.5.25",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "hono": "4.12.33",
    "postcss": "8.5.25",
    "uuid": "11.1.1",
    "ws": "^8.21.0"
  }
}
