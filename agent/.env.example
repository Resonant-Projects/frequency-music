# Convex agent tool surface
CONVEX_SITE_URL=https://convex.resonantprojects.art
AGENT_TOOL_SECRET=

# Direct Anthropic is primary for every worker graph, including tool calls.
# The runtime injects this from the 1Password item in agent/.env.schema.
ANTHROPIC_API_KEY=

# Legacy Codex paths apply only without an Anthropic key.
CODEX_ENABLED=false
# Optional; defaults to ~/.codex. The Proxmox worker mounts a volume here.
CODEX_HOME=
# Optional model override passed to the SDK (else the CLI default).
CODEX_MODEL=
# read-only | workspace-write (plan 05 verification uses workspace-write).
CODEX_SANDBOX_MODE=read-only
# Scratch workingDirectory for Codex threads.
CODEX_WORKDIR=/tmp/codex-scratch
# When true, the research-pipeline review-draft node delegates to a Codex
# thread (runCodexTask) instead of the Anthropic specialist when ANTHROPIC_API_KEY is absent; defaults off.
CODEX_SPECIALIST=

# Legacy provider, used only when ANTHROPIC_API_KEY is absent
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
# Self-hosted Firecrawl instead of Cloud (no key needed), e.g. http://172.16.10.38:3002
FIRECRAWL_API_URL=
WEEKLY_BRIEF_AGENT_MODEL=anthropic/claude-sonnet-5.5

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=frequency-music-agents

# Proxmox cluster API for deployment scripts/spikes.
# Keep token values in .env.local or runtime secrets. Never commit populated values.
PROXMOX_API_URL=https://prox.rproj.art:8006/api2/json
# Set true for homelab Proxmox certificates that are not trusted by the local OS trust store.
PROXMOX_ALLOW_SELF_SIGNED=true
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Opt in to free keyless Firecrawl Cloud Research Index discovery.
# The self-hosted Firecrawl service does not supply this index.
ALEXANDRIA_RESEARCH_ENABLED=false

# Dedicated MCP process: separate inbound credential, never AGENT_TOOL_SECRET.
MCP_SHARED_SECRET=
MCP_PORT=2025
