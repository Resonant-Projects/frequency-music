# Convex agent tool surface
CONVEX_SITE_URL=http://convex-backend.paas.rproj.art
AGENT_TOOL_SECRET=

# Primary model spike/provider: Codex App Server
# If CODEX_APP_SERVER_URL is set, non-tool graph/model calls can use the local Codex adapter.
# Tool-using deepagents still use OpenRouter/Anthropic fallback until Codex tool-calling support is confirmed.
CODEX_APP_SERVER_URL=
CODEX_APP_SERVER_AUTH_TOKEN=
CODEX_APP_SERVER_MODEL=codex-local

# Fallback model provider for tool-using DeepAgents
OPENROUTER_API_KEY=
WEEKLY_BRIEF_AGENT_MODEL=anthropic/claude-sonnet-4.6

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=frequency-music-agents

# Proxmox cluster API for deployment scripts/spikes.
# Keep token values in .env.local or runtime secrets. Never commit populated values.
PROXMOX_API_URL=https://prox.rproj.art:8006/api2/json
# Set true for homelab Proxmox certificates that are not trusted by the local OS trust store.
PROXMOX_ALLOW_SELF_SIGNED=true
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
