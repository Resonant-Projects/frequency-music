# Convex agent tool surface
CONVEX_SITE_URL=http://convex-backend.paas.rproj.art
AGENT_TOOL_SECRET=

# Primary non-tool inference provider: Codex SDK (ChatGPT subscription auth).
# When CODEX_ENABLED=true, non-tool graph/model calls run on the local `codex`
# CLI via @openai/codex-sdk, reusing `codex login` state from CODEX_HOME. Tool-
# binding calls stay on OpenRouter/Anthropic, which is also the automatic
# fallback on Codex auth/quota/transient errors.
CODEX_ENABLED=true
# Optional; defaults to ~/.codex. The Proxmox worker mounts a volume here.
CODEX_HOME=
# Optional model override passed to the SDK (else the CLI default).
CODEX_MODEL=
# read-only | workspace-write (plan 05 verification uses workspace-write).
CODEX_SANDBOX_MODE=read-only
# Scratch workingDirectory for Codex threads.
CODEX_WORKDIR=/tmp/codex-scratch
# When true, the research-pipeline review-draft node delegates to a Codex
# thread (runCodexTask) instead of the OpenRouter specialist; defaults off.
CODEX_SPECIALIST=

# Fallback model provider for tool-using DeepAgents
OPENROUTER_API_KEY=
WEEKLY_BRIEF_AGENT_MODEL=anthropic/claude-sonnet-4.6

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=frequency-music-agents

# Proxmox cluster API for deployment scripts/spikes.
# Keep token values in .env.local or runtime secrets. Never commit populated values.
PROXMOX_API_URL=https://prox.rproj.art:8006/api2/json
# Set true for homelab Proxmox certificates that are not trusted by the local OS trust store.
PROXMOX_ALLOW_SELF_SIGNED=true
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
