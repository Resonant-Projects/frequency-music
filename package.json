{
  "name": "frequency-music",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "prepare": "vp config --no-agent",
    "check:file-tokens": "node scripts/check-file-tokens.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "vp lint convex harness scripts --fix --tsconfig tsconfig.json",
    "lint:check": "vp lint convex harness scripts --tsconfig tsconfig.json",
    "test": "vp test convex scripts",
    "test:recovery": "bash scripts/recovery/tests/test-isolated-restore-guest.sh && bash scripts/recovery/tests/smoke-guest-module-identities.sh && bash scripts/recovery/tests/test-rehearsal-block.sh && bash scripts/recovery/tests/test-host-receipt-reads.sh && python3 scripts/recovery/tests/test-guest-receipt-reads.py",
    "test:harness": "vp test harness",
    "test:agent": "cd agent && vp test",
    "test:media": "cd media && ./node_modules/.bin/vp test",
    "typecheck": "vp run typecheck:scripts && vp run typecheck:web && vp run typecheck:agent && vp run typecheck:media",
    "typecheck:scripts": "vpx tsc --noEmit",
    "typecheck:agent": "cd agent && vpx tsc --noEmit",
    "typecheck:media": "cd media && vpx tsc --noEmit",
    "build:web": "cd web && vp run build",
    "typecheck:web": "cd web && vpx tsc --noEmit",
    "verify": "vp run format:check && vp run lint:check && vp run typecheck && vp test convex scripts && vp run test:harness && vp run test:agent && vp run test:media",
    "essays:metadata": "vpx tsx scripts/generate-essay-metadata.ts",
    "essays:export": "vpx tsx scripts/export-essays.ts",
    "essays:publish": "vp run essays:metadata && vp run essays:export",
    "eval:export": "vpx tsx scripts/export-eval-datasets.ts",
    "convex:extract": "vpx convex run workflows:startBatchExtraction '{\"limit\": 3}'",
    "convex:deploy": "vp run typecheck:scripts && vpx tsx scripts/convex-deploy.ts",
    "convex:deploy:dry-run": "vp run typecheck:scripts && vpx tsx scripts/convex-deploy.ts --dry-run",
    "graph:backfill": "vpx tsx scripts/graph-backfill.ts",
    "env:check": "varlock load",
    "env:check:all": "varlock load --show-all"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/groq": "^4.0.59",
    "@ai-sdk/openai": "^4.0.96",
    "@convex-dev/action-cache": "^0.3.1",
    "@convex-dev/aggregate": "^0.3.2",
    "@convex-dev/rag": "^0.7.8",
    "@convex-dev/workflow": "^0.4.10",
    "@convex-dev/workpool": "^0.4.14",
    "@onkernel/sdk": "^0.123.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.137",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.128",
    "langsmith": "^0.11.0",
    "marked": "^18.1.0",
    "midi-file": "^1.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^26.6.5",
    "@varlock/1password-plugin": "^2.0.5",
    "convex-test": "^0.0.64",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "varlock": "^1.22.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "ws": "^8.21.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
