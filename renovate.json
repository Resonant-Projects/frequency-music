{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "bun",
    "dockerfile"
  ],
  "ignorePaths": [
    "scripts/archive/**"
  ],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 3-5 * * 1"
    ]
  },
  "packageRules": [
    {
      "description": "Approve major upgrades in the dependency dashboard first.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep Convex dependencies together across runtime packages.",
      "matchPackageNames": [
        "convex",
        "convex-helpers",
        "@convex-dev/*"
      ],
      "groupName": "Convex dependencies"
    },
    {
      "description": "Update Vite Plus and its aliased packages together.",
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "@voidzero-dev/vite-plus-test"
      ],
      "groupName": "Vite Plus"
    },
    {
      "description": "Bun runtime upgrades must also update CI and Dockerfile pins.",
      "matchPackageNames": [
        "bun"
      ],
      "enabled": false
    },
    {
      "description": "Preserve digest-pinned Docker base images.",
      "matchManagers": [
        "dockerfile"
      ],
      "pinDigests": true
    },
    {
      "description": "Keep the single LangSmith version below 0.10 while DeepAgents 1.14 requires its real >=0.7.1 <0.10.0 peer range.",
      "matchFileNames": [
        "package.json",
        "agent/package.json"
      ],
      "matchPackageNames": [
        "langsmith"
      ],
      "allowedVersions": ">=0.7.1 <0.10.0"
    },
    {
      "description": "LangGraph API 1.5 requires TypeScript 5; other packages retain their own compiler versions.",
      "matchFileNames": [
        "agent/package.json"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": ">=5.5.4 <6"
    },
    {
      "description": "Keep Core compatible with the single LangSmith 0.9 SDK required by DeepAgents; Core 1.2.18+ requires LangSmith >=0.11.",
      "matchFileNames": [
        "agent/package.json"
      ],
      "matchPackageNames": [
        "@langchain/core"
      ],
      "allowedVersions": ">=1.2.14 <1.2.18"
    },
    {
      "description": "Keep LangChain compatible with the single LangSmith 0.9 SDK required by DeepAgents; newer releases require LangSmith >=0.11.",
      "matchFileNames": [
        "agent/package.json"
      ],
      "matchPackageNames": [
        "langchain"
      ],
      "allowedVersions": ">=1.5.10 <=1.5.12"
    },
    {
      "description": "Keep the CLI on its real LangSmith ^0.9 range while DeepAgents requires <0.10; CLI 1.5.2+ requires ^0.10.5.",
      "matchFileNames": [
        "agent/package.json"
      ],
      "matchPackageNames": [
        "@langchain/langgraph-cli"
      ],
      "allowedVersions": ">=1.5.0 <1.5.2"
    },
    {
      "description": "Group Biome packages on the weekly Monday morning schedule.",
      "matchPackageNames": [
        "@biomejs/**"
      ],
      "groupName": "Biome",
      "schedule": [
        "* 3-5 * * 1"
      ],
      "timezone": "America/New_York"
    }
  ]
}
