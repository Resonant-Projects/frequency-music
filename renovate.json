{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["bun", "dockerfile"],
  "ignorePaths": ["scripts/archive/**"],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 3-5 * * 1"]
  },
  "packageRules": [
    {
      "description": "Approve major upgrades in the dependency dashboard first.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep Convex dependencies together across runtime packages.",
      "matchPackageNames": ["convex", "convex-helpers", "@convex-dev/*"],
      "groupName": "Convex dependencies"
    },
    {
      "description": "Update Vite Plus and its aliased packages together.",
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "@voidzero-dev/vite-plus-test"
      ],
      "groupName": "Vite Plus"
    },
    {
      "description": "Bun runtime upgrades must also update CI and Dockerfile pins.",
      "matchPackageNames": ["bun"],
      "enabled": false
    },
    {
      "description": "Preserve digest-pinned Docker base images.",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    },
    {
      "description": "DeepAgents 1.14 requires LangSmith below 0.10; keep its real peer range until upstream supports newer SDKs.",
      "matchFileNames": ["agent/package.json"],
      "matchPackageNames": ["langsmith"],
      "allowedVersions": ">=0.7.1 <0.10.0"
    },
    {
      "description": "LangGraph API 1.5 requires TypeScript 5; other packages retain their own compiler versions.",
      "matchFileNames": ["agent/package.json"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": ">=5.5.4 <6"
    }
  ]
}
