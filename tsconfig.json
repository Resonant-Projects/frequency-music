{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["node"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // web/, agent/, and media/ are their own TypeScript projects. Sweeping them
  // from the root project applies the wrong compiler boundary; package.json
  // typechecks each workspace separately via typecheck:web, typecheck:agent,
  // and typecheck:media.
  // scripts/archive/ holds completed one-shot scripts kept byte-identical for
  // reference and never run (see AGENTS.md); they carry stale relative imports
  // and Bun globals, so exclude them from the root typecheck.
  "exclude": ["node_modules", "web", "agent", "media", "scripts/archive"]
}
