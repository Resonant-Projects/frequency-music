# Frequency Music — test environment (APP_ENV=test)
#
# COMMITTED ON PURPOSE. Every value here is an inert placeholder, never a real
# credential. It exists so `vp test scripts` can run tests that spawn a CLI
# subprocess (which loads `varlock/auto-load` for real) without any 1Password
# access — the desktop app is unavailable on CI runners and no service-account
# token is issued for the unit-test job.
#
# Contract: every op()-backed var in .env.schema needs a placeholder here. Add a
# secret to the schema → add its placeholder below, or the subprocess tests
# start failing with "Unable to authenticate with 1Password".
#
# Never put a real secret in this file. Local overrides belong in .env.local.

APP_ENV=test

AUTH_BYPASS_SECRET=test-placeholder
AGENT_TOOL_SECRET=test-placeholder
OPENROUTER_API_KEY=test-placeholder
OPENAI_API_KEY=test-placeholder
FIRECRAWL_API_KEY=test-placeholder
GROQ_API_KEY=test-placeholder
NOTION_API_KEY=test-placeholder
KERNEL_API_KEY=test-placeholder
READWISE_TOKEN=test-placeholder
INGEST_SHARED_SECRET=test-placeholder
LANGSMITH_API_KEY=test-placeholder
CONVEX_DEPLOY_KEY=test-placeholder
CONVEX_SELF_HOSTED_ADMIN_KEY=test-placeholder
