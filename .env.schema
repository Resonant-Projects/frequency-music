# Frequency Music — environment schema (varlock + 1Password)
#
# This file is the COMMITTED source of truth for every environment variable the
# repo reads (root scripts + the Convex backend's deployment env). Secrets are
# resolved at runtime from the `Country Manor Lab` 1Password vault via the op()
# resolver — no secret values live in git. Non-secret config has committed
# defaults below and may be overridden locally in .env.local (gitignored).
#
# Local dev (Mac):   the 1Password desktop app unlocks secrets via biometric
#                    (allowAppAuth=forEnv(dev)). No token needed on the machine.
# CI / headless:     set APP_ENV=ci and OP_SERVICE_ACCOUNT_TOKEN to a
#                    1Password service-account token.
#
# Load it in a script:   import "varlock/auto-load";   (populates process.env)
# Inspect resolved vals:  bunx varlock load
#
# @defaultSensitive=true @defaultRequired=infer
# @currentEnv=$APP_ENV
# @generateTypes(lang=ts, path=./env.d.ts)
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=forEnv(dev))
# ---

# Deployment/runtime flag. Drives which 1Password auth mode is used.
# @public @type=enum(dev, ci, prod)
APP_ENV=dev

# 1Password service-account token — ONLY for CI/headless (APP_ENV=ci|prod).
# Leave empty for local dev (the desktop app handles auth via biometric).
# @optional @type=opServiceAccountToken
OP_SERVICE_ACCOUNT_TOKEN=

# ─── Non-secret config (committed defaults; override in .env.local) ──────────

# Self-hosted Convex backend URL. TODO: migrate to https:// (see SECURITY-04).
# @public @type=url
CONVEX_URL=https://convex.resonantprojects.art

# Alias for scripts that read CONVEX_SELF_HOSTED_URL.
# @public @type=url
CONVEX_SELF_HOSTED_URL=ref(CONVEX_URL)

# Public app base URL (editorial export + weekly briefs).
# @public @type=url
PUBLIC_APP_BASE_URL=https://app.resonantprojects.art

# Server-side auth-bypass toggle (Convex deployment env). Keep false unless a
# deployment explicitly enables CLI bypass.
# @public @optional @type=boolean
AUTH_BYPASS_ENABLED=false

# Notion weekly-briefs database id (an identifier, not a secret).
# @public @optional
NOTION_WEEKLY_BRIEFS_DB=

# LangSmith tracing config (best-effort; never blocks the pipeline).
# @public @optional @type=boolean
LANGSMITH_TRACING=true
# @public @optional
LANGSMITH_PROJECT=resonant-projects-prod
# @public @optional @type=url
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional batch-script input (comma-separated source ids).
# @public @optional
SOURCE_IDS=

# ─── Secrets (resolved from 1Password vault: Country Manor Lab) ───────────────

# Convex write-bypass credential. ROTATE immediately after deployment —
# previous values in git history cannot be revoked and must be assumed compromised.
# @sensitive @required
AUTH_BYPASS_SECRET=op(op://Country Manor Lab/auth-bypass-secret/credential)

# Alias for scripts/CI that read DEV_BYPASS_SECRET.
# @sensitive @required
DEV_BYPASS_SECRET=ref(AUTH_BYPASS_SECRET)

# Read-only external agent tool surface secret.
# @sensitive @required
AGENT_TOOL_SECRET=op(op://Country Manor Lab/agent-tool-secret/credential)

# OpenRouter LLM gateway key.
# @sensitive @required
OPENROUTER_API_KEY=op(op://Country Manor Lab/openrouter-api-key/credential)

# Groq fast-model key (cron extractions).
# @sensitive @optional
GROQ_API_KEY=op(op://Country Manor Lab/groq-api-key/credential)

# Notion integration token.
# @sensitive @optional
NOTION_API_KEY=op(op://Country Manor Lab/notion-api-key/credential)

# Kernel.sh cloud-browser key (blocked-source fetch scripts).
# @sensitive @optional
KERNEL_API_KEY=op(op://Country Manor Lab/kernel-api-key/credential)

# Readwise export token.
# @sensitive @optional
READWISE_TOKEN=op(op://Country Manor Lab/readwise-token/credential)

# Convex HTTP ingest shared secret.
# @sensitive @optional
INGEST_SHARED_SECRET=op(op://Country Manor Lab/ingest-shared-secret/credential)

# Legacy alias for the ingest secret.
# @sensitive @optional
N8N_INGEST_SECRET=ref(INGEST_SHARED_SECRET)

# LangSmith API key (tracing + eval upload).
# @sensitive @optional
LANGSMITH_API_KEY=op(op://Country Manor Lab/langsmith-api-key/credential)

# Convex admin deploy key — CI only.
# @sensitive @optional
CONVEX_DEPLOY_KEY=op(op://Country Manor Lab/convex-deploy-key/credential)

# Self-hosted Convex admin key (used by the convex CLI against the self-hosted
# backend, e.g. `bunx convex run/env`). Keep in .env.local or 1Password.
# @sensitive @optional
CONVEX_SELF_HOSTED_ADMIN_KEY=op(op://Country Manor Lab/convex-self-hosted-admin-key/credential)
