# Frequency Music — media service environment schema (varlock + 1Password)
# @defaultSensitive=true @defaultRequired=infer
# @currentEnv=$APP_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=forEnv(dev))
# ---

# @public @type=enum(dev, ci, prod, test)
APP_ENV=dev
# @optional @type=opServiceAccountToken
OP_SERVICE_ACCOUNT_TOKEN=

# The Convex *site* (HTTP actions) at the backend's own CONVEX_SITE_ORIGIN:
# Cloudflare, then Nginx Proxy Manager, then convex:3211. Upload URLs minted by
# generateAudioUploadUrl carry this origin, so it is the only one a worker can
# use. The LAN address http://convex.rproj.art:3211 needs
# MEDIA_ALLOW_INSECURE_CONVEX=true because the tool secret rides in every
# request body; ai-5090-02 cannot reach it anyway (no route to the lab VLAN).
# @public @type=url
CONVEX_SITE_URL=https://convex-http.resonantprojects.art
# Set to "true" only with an http:// CONVEX_SITE_URL on a private network.
# @public @optional
MEDIA_ALLOW_INSECURE_CONVEX=
# @public @optional
MEDIA_WORKER_ID=ai-5090-02
# @public @optional @type=number
MEDIA_POLL_INTERVAL_MS=15000
# @public @optional
MEDIA_JOB_KINDS=probe
# @public @optional
MEDIA_WORK_DIR=/work

# @sensitive @required
AGENT_TOOL_SECRET=op("op://Country Manor Lab/agent-tool-secret/credential")

# TTS provider keys for narration takes (convex/shared/voices.ts names the env
# var each voice reads). Hosted keys resolve from Country Manor Lab / Homelab
# Runtime items once they exist; a missing key simply leaves that voice
# unconfigured and its takes are skipped.
# @sensitive @optional
GEMINI_API_KEY=
# @sensitive @optional
INWORLD_API_KEY=
# @sensitive @optional
ELEVENLABS_API_KEY=
# Breeze TTS 2 runs locally behind an OpenAI-style /v1/audio/speech; the key
# is whatever the local server expects (often a placeholder).
# @sensitive @optional
BREEZE_TTS_API_KEY=
# @public @optional @type=url
BREEZE_TTS_BASE_URL=http://tts-local:8881
