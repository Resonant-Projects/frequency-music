# Frequency Music — web (Vite/SolidJS) environment schema (varlock + 1Password)
#
# Public client config is @public and is inlined into the browser bundle.
# Test-harness secrets are @sensitive — varlock NEVER inlines them into the
# bundle; they are available only to Node-side test code via process.env.
#
# Activation: install the Vite plugin and register it in vite.config.ts (see
# the migration notes). Until then this file documents the contract and feeds
# the vault inventory; it is inert.
#
# @defaultSensitive=true @defaultRequired=infer
# @currentEnv=$APP_ENV
# @generateTypes(lang=ts, path=./env.d.ts)
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=forEnv(dev))
# ---

# @public @type=enum(dev, ci, prod)
APP_ENV=dev

# 1Password service-account token — CI/headless only.
# @optional @type=opServiceAccountToken
OP_TOKEN=

# ─── Public client config (inlined into the browser bundle) ─────────────────

# @public @required @type=url
VITE_CONVEX_URL=http://convex-backend.paas.rproj.art

# @public @optional @type=url
VITE_CLERK_SIGN_IN_URL=https://login.resonantrhythm.com/sign-in
# @public @optional @type=url
VITE_CLERK_SIGN_UP_URL=https://login.resonantrhythm.com/sign-up
# @public @optional
VITE_CLERK_AFTER_SIGN_IN_URL=/
# @public @optional
VITE_CLERK_AFTER_SIGN_UP_URL=/

# Clerk publishable key — publishable keys are client-safe by design.
# @public @optional
VITE_CLERK_PUBLISHABLE_KEY=op(op://frequency-music/clerk/publishable-key)

# Dev/e2e client flags (booleans, not secrets). "1" enables.
# @public @optional
VITE_AUTH_BYPASS=
# @public @optional
VITE_E2E_MODE=

# ─── Test-harness only (Node-side; never inlined into the client bundle) ─────

# Convex write-bypass credential used by e2e cleanup. @sensitive keeps it out
# of the browser bundle even though it sits in the web workspace.
# @sensitive @optional
AUTH_BYPASS_SECRET=op(op://frequency-music/auth-bypass-secret/credential)

# Toggle for the live weekly-brief e2e (not a secret).
# @public @optional
RUN_LIVE_BRIEF_E2E=
