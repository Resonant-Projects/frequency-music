{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "renovate/**": false,
      "docs/verify-*": false
    }
  },
  "rewrites": [
    {
      "source": "/podcast/:token/feed.xml",
      "destination": "https://listen.rproj.art/podcast/:token/feed.xml"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
